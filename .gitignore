data/
# Exception : les fichiers de config Hydra dans configs/data/ sont à versionner
# (ils décrivent où chercher les données, pas les données elles-mêmes).
!configs/data/
__pycache__/

# Artefacts de build / packaging
*.egg-info/
build/
dist/

# Tests & couverture
.pytest_cache/
.coverage
.coverage.*
htmlcov/
coverage.xml

# Environnements virtuels
.venv/

# Poids pré-entraînés (Prithvi WxC, Granite) — peuplés par `fetch-pretrained`
modelstore/
docs/_build/

# Outputs ML locaux — ne jamais committer (binaires lourds, runs ad-hoc).
# Découverts au cleanup PMAP : `git add -A` les avait staged accidentellement.
artifacts/
checkpoints/
wandb/

# Artefacts métriques opposabilité (#88) — caches/paires volumineux
artifacts/arome_sencrop/*.pkl
