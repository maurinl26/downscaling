    "n_time_steps_3h": 9200,
    "optimizer": "Adam",
    "lr_schedule": "cosine with 5-epoch warmup",
    "batch_size": 16,
    "epochs": 100,
    "early_stopping": "val/rmse, patience 10",
    "seeds": [0, 1, 2, 3, 4]
  },
  "validation": {
    "period": "2022-2025 (Feb-May)",
    "n_nights": 481,
    "n_station_obs": 16768,
    "auc": 0.964,
    "pod_at_far_0_20": 0.316,
    "pod_at_far_0_20_with_station_debias": 0.611
  },
  "release": {
