{
  "architecture": "unet",
  "met_in_ch": 5,
  "dem_in_ch": 4,
  "base_ch": 64,
  "n_levels": 4,
  "use_film": true,
  "input_grid": {
    "height": 168,
    "width": 120,
    "resolution_km": 1.0,
    "region": "Baronnies Provençales (lat 44.1-44.6 N, lon 5.1-5.7 E)",
